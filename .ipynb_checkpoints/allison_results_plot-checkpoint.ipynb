   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "This script visualizes daily temperatures calculated using driver data from the example folder and measured data from the corresponding permafrost monitoring station. "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "metadata": {},
   "outputs": [],
   "source": [
    "%matplotlib inline\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import subprocess\n",
    "from matplotlib import pyplot as plt\n",
    "import yaml\n",
    "import os\n",
    "from pathlib import Path\n",
    "GIPL_PATH = Path(f\"{os.getcwd()}\")\n",
    "ROOT_OUTPUT_PATH = Path(f\"{os.getenv('HOME')}/gipl_experiments\")\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "For some years snow depth needd to corrected to match warm tempratures in the sping. Tair>0 -> no snow. "
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
     "metadata": {},
     "output_type": "execute_result"
    },
    {
     "data": {
      "text/plain": [
       "<Figure size 640x480 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "ubound_file='in/bound.txt'\n",
    "ubound = np.loadtxt(ubound_file, skiprows=1,  unpack=False)\n",
    "df_tair = pd.DataFrame(ubound[:,-1:], columns=['Tair [C]']) \n",
    "\n",
    "snow_file='in/snow.txt'\n",
    "dsnow = np.loadtxt(snow_file, skiprows=1,  unpack=False)\n",
    "df_dsnow = pd.DataFrame(dsnow[:,-1:], columns=['snow depth[m]']) \n",
    "\n",
    "rsnow_file='in/rsnow.txt'\n",
    "rsnow = np.loadtxt(rsnow_file, skiprows=1,  unpack=False)\n",
    "df_rsnow = pd.DataFrame(rsnow[:,-1:], columns=['snow cond[W/m/K]']) \n",
    "\n",
    "plt.plot(df_tair[df_tair>-2], alpha=0.6)\n",
    "plt.plot(df_dsnow*10)"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "<Figure size 640x480 with 2 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# Ensure that the indices match or align them if necessary\n",
    "df_tair.index = pd.RangeIndex(start=0, stop=len(df_tair), step=1)\n",
    "df_dsnow.index = pd.RangeIndex(start=0, stop=len(df_dsnow), step=1)\n",
    "\n",
    "# Create the plot with two y-axes\n",
    "fig, ax1 = plt.subplots()\n",
    "\n",
    "# Plot the first dataset on the primary y-axis\n",
    "ax1.plot(df_tair.index, df_tair['Tair [C]'], color='tab:blue', alpha=0.5)\n",
    "ax1.set_xlabel('Index')\n",
    "ax1.set_ylabel('Tair [C]', color='tab:blue')\n",
    "ax1.tick_params(axis='y', labelcolor='tab:blue')\n",
    "\n",
    "# Create a secondary y-axis and plot the second dataset\n",
    "ax2 = ax1.twinx()\n",
    "ax2.plot(df_dsnow.index, df_dsnow['snow depth[m]'], color='tab:red')\n",
    "ax2.set_ylabel('snow depth[m]', color='tab:red')\n",
    "ax2.tick_params(axis='y', labelcolor='tab:red')\n",
    "\n",
    "# Add a title and show the plot\n",
    "plt.title('Tair and Snow Depth')\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "Load calculated and measured temperatures. "
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "outputs": [],
   "source": [
    "def load_calc():\n",
    "    calc_file='out/result.txt'\n",
    "    calc_data = np.loadtxt(calc_file, skiprows=0,  unpack=False)\n",
    "    calc_header=['id','time','Tair','snow','0.01m', '0.08m', '0.13m', '0.24m', '0.38m', '0.53m', '0.67m' ]\n",
    "    df = pd.DataFrame(calc_data, columns=calc_header) \n",
    "    return df\n",
    "\n",
    "def load_meas():\n",
    "    meas_file='mesres.txt'\n",
    "    df_meas =  np.loadtxt(meas_file, skiprows=0,  unpack=False)#pd.read_csv(meas_file)\n",
    "    df = pd.DataFrame(df_meas, columns=['0.01m', '0.08m', '0.13m', '0.24m', '0.38m', '0.53m', '0.67m'])\n",
    "    df_365 = df.head(1095)\n",
    "    return df_365\n",
    "\n",
    "df_calc=load_calc()\n",
    "df_meas=load_meas()"
   ]
  },
